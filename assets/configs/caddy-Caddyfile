# ============================================================================
# Caddyfile — reverse proxy compartilhado + forward-auth do Authelia.
# Guia: ../../docs/caddy.md   Stack: ../stacks/caddy.yml
#
# Grave em /srv/caddy/Caddyfile no host.
# O cloudflared (bare-metal) aponta TODOS os hostnames para http://localhost:8080.
# ============================================================================

{
	# O TLS termina no Cloudflare; o cloudflared entrega HTTP puro ao Caddy.
	# Então o Caddy NÃO provisiona certificados e só serve HTTP na 8080.
	auto_https off
	http_port 8080
	admin off

	# Atrás do cloudflared: confiar nos proxies internos faz o Caddy PRESERVAR
	# o X-Forwarded-Proto: https (senão o Authelia monta redirect http:// e cai
	# em loop de redirect / cookie secure descartado).
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}

	log {
		output stdout
		format console
	}
}

# --- Snippet de forward-auth do Authelia (importe em cada host protegido) ----
# Em 2xx o Caddy copia os headers de identidade antes do proxy; em 302 devolve
# o redirect do portal ao browser.
(comprimir) {
	encode zstd gzip
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

# --- Portal do Authelia (público; NÃO passa pelo forward_auth) ---------------
http://auth.selflabs.org {
	import comprimir
	reverse_proxy authelia:9091
}

# --- UI web do lldap (protegida) --------------------------------------------
http://users.selflabs.org {
	import comprimir
	import authelia
	reverse_proxy lldap:17170
}

# --- BentoPDF (protegido) ----------------------------------------------------
# Alcançado pelo nome do container via rede externa `caddy-net` (sem porta no host).
# O app é 100% client-side: NÃO sobrescreva aqui os headers Cross-Origin-Opener-Policy
# e Cross-Origin-Embedder-Policy que vêm do nginx da imagem. São eles que liberam o
# SharedArrayBuffer usado pelas conversões de Office (LibreOffice WASM).
http://pdf.selflabs.org {
	import comprimir
	import authelia
	reverse_proxy bentopdf:8080
}

# --- Portainer (login PRÓPRIO; SEM Authelia) --------------------------------
# NÃO usa `import authelia`: o forward-auth barraria as chamadas programáticas
# (webhook do GitHub = POST sem sessão de browser -> 302 login -> quebra).
# O Portainer se protege com o login dele; os webhooks usam token na URL.
http://portainervps.selflabs.org {
	import comprimir
	reverse_proxy portainer:9000
}

# --- CriarViral (público; SEM Authelia) --------------------------------------
# SaaS público com login próprio (Auth.js). NÃO usa `import authelia`: o app
# autentica os usuários dele, e os webhooks do Mercado Pago (POST sem sessão
# de browser) precisam chegar direto. Stack: ../stacks/criarviral.yml
http://criarviral.selflabs.org {
	import comprimir
	reverse_proxy criarviral:3000
}

# --- radar (SOMENTE /admin protegido) ---------------------------------------
# Diferente dos outros hosts, aqui o forward-auth recebe um MATCHER em vez de
# valer para o host inteiro: a landing, os shortlinks (/r/:code, /whats, /tele),
# o /webhook/evolution e as rotas /internal/* (chamadas pelo n8n, já protegidas
# no app por x-internal-token) precisam continuar abertos e NÃO podem depender
# de o Authelia estar de pé.
# Use `path /admin /admin/*` e NUNCA `path /admin*`: este último casaria também
# /administrador e qualquer outro path com o mesmo prefixo textual.
http://radar.selflabs.org {
	import comprimir
	@admin path /admin /admin/*
	forward_auth @admin authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy radar-backend:8082
}

# --- CortenDesk: console + web client do RustDesk (login PRÓPRIO; SEM Authelia)
# NÃO usa `import authelia`: o forward-auth quebraria o handshake dos WebSockets
# do web client (/ws/id e /ws/relay). O app se protege com o login dele + 2FA
# (TOTP), configurável em Settings. Guia: ../../docs/rustdesk-server.md (Parte 6).
# Todos os paths vão para a 8080: o próprio container faz o bridge WSS para o
# hbbs (21118) e o hbbr (21119) via host.docker.internal, então NÃO roteie
# /ws/* aqui. Hostname separado do `rustdesk-id` (esse é nuvem cinza, protocolo
# nativo); este é proxied/laranja e chega pelo cloudflared.
http://rustdesk.selflabs.org {
	import comprimir
	reverse_proxy cortendesk:8080
}

# --- ALFERES ---
# Login e RBAC próprios: sem forward-auth, como criarviral e portainervps.
http://alferes.selflabs.org {
        import comprimir
        reverse_proxy alferes-app:3000
}

# --- hubb-monitor: painel de monitoramento dos clientes ----------------------
# Painel atrás do Authelia, com quatro caminhos abertos de propósito:
#   /api/beszel/agent-connect  WebSocket dos agentes. O forward-auth quebraria o
#                              handshake, e o hub confere o token de cada agente.
#   /api/sinal/*               sinais do HA e do ha-backup; o token vai na URL.
#   /api/saude                 lido pelo vigia do homelab; não traz dado de cliente.
#   /email-logo.png            a marca do cabeçalho dos e-mails de alerta, que o
#                              leitor de e-mail baixa sem sessão do Authelia.
# Stack: monitoramento (repo self-labs/hubb-monitor, docker-compose.yml).
http://monitor.selflabs.org {
	@agentes path /api/beszel/agent-connect
	handle @agentes {
		reverse_proxy beszel:8090
	}
	@abertos path /api/sinal/* /api/saude /email-logo.png
	handle @abertos {
		reverse_proxy hubb-monitor:3000
	}
	handle {
		import comprimir
		import authelia
		reverse_proxy hubb-monitor:3000
	}
}

# Modelo para adicionar um app novo --------------------------------------
# 1) o app entra na rede externa `caddy-net`;
# 2) copie o bloco abaixo (usar import authelia quando não há login) ;
# 3) no cloudflared publique novo.selflabs.org -> http://localhost:8080.
# http://novo.selflabs.org {
# 	import authelia
# 	reverse_proxy nome-do-container:porta
# }
#
# Para proteger APENAS um trecho do app (o resto continua público), passe um
# matcher ao forward_auth em vez de usar `import authelia` no host inteiro:
# http://novo.selflabs.org {
# 	@privado path /admin /admin/*
# 	forward_auth @privado authelia:9091 {
# 		uri /api/authz/forward-auth
# 		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
# 	}
# 	reverse_proxy nome-do-container:porta
# }
