<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://adguard.selflabs.org/dns-query</string>
            </dict>
            <!-- Em casa o DHCP do Deco entrega o AdGuard e, de reserva, o AdGuard DNS
                 publico (94.140.14.14), os dois com filtro: ai o perfil sai do caminho e
                 o iPhone usa o DNS da rede. Com qualquer outro DNS na lista (um sem
                 filtro, o IPv6 do provedor) a regra nao casa e o DoH continua. O IP de
                 casa entra no deploy pela variavel ADGUARD_LAN_IP. -->
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>Disconnect</string>
                    <key>DNSServerAddressMatch</key>
                    <array>
                        <string>__ADGUARD_LAN_IP__</string>
                        <string>94.140.14.14</string>
                    </array>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
            </array>
            <key>PayloadDescription</key>
            <string>Configura DNS-over-HTTPS via AdGuard Home — Self-Labs</string>
            <key>PayloadDisplayName</key>
            <string>AdGuard Home — Self-Labs</string>
            <key>PayloadIdentifier</key>
            <string>org.selflabs.adguard.doh</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>6C4CD57E-9037-47A6-B92B-9B71ABDFCE0C</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Instala o perfil de DNS-over-HTTPS usando o AdGuard Home do Self-Labs. Todas as consultas DNS serão filtradas e protegidas.</string>
    <key>PayloadDisplayName</key>
    <string>AdGuard Home DoH — Self-Labs</string>
    <key>PayloadIdentifier</key>
    <string>org.selflabs.adguard.profile</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>DCB6D0C3-8677-4CCF-8410-6BDC91055178</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
