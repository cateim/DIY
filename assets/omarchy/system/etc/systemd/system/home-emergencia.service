# versao 2026-11-01 (roteiro D4)
[Unit]
Description=Home de emergencia quando o Crucial nao monta
After=home.mount
Wants=home.mount
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c 'mountpoint -q /home || mount --bind /home /home'

[Install]
WantedBy=multi-user.target
