# ==============================================================
# DIY Omarchy: valores pessoais e segredos fora do repositório
# Copie para ~/.config/diy-omarchy/private.env (chmod 600) e preencha.
# Nunca commite o private.env. Guarde uma cópia no Bitwarden: ele tem a
# senha do VNC e é o que devolve cada valor numa reinstalação.
# Formato: arquivo bash (KEY=valor; aspas se tiver espaço ou quebra de linha).
# ==============================================================

# ---- Trocados por <<NOME>> pelo export.sh e devolvidos pelo install.sh ----
DOMAIN=                        # domínio próprio (remote.<DOMAIN> é o VNC no navegador)
GIT_NAME=                      # user.name do git
GIT_EMAIL=                     # user.email do git
FORGEJO_ONION=                 # endereço .onion do Forgejo (proxy Tor 9150 no ~/.gitconfig)
WAYVNC_PASSWORD=               # senha do wayvnc; o cliente da Cloudflare só usa 8 caracteres
CHROMIUM_OAUTH_CLIENT_ID=      # sync do Google no Chromium (chaves públicas do projeto Chromium)
CHROMIUM_OAUTH_CLIENT_SECRET=
VPS_NAME=                      # nome da VPS citado nos comentários (prompt e cores do eza)
HOMELAB_NAME=                  # nome do servidor do homelab citado nos comentários do prompt

# ---- Lidos pelo scripts/ssh-no-boot.sh (desbloqueio do LUKS por SSH) ----
BOOT_IP=                       # IP fixo do cabo no initramfs
BOOT_GW=                       # gateway da rede
BOOT_MASK=255.255.255.0        # máscara
BOOT_DEV=eth0                  # placa no initramfs (enp59s0 no sistema)
BOOT_HOSTNAME=alienware
UNLOCK_ROOT_KEYS=''            # chaves ssh-ed25519 autorizadas, uma por linha (tinyssh não aceita RSA)
