#!/usr/bin/env bash
# Enquanto houver alguém no VNC: não abre o protetor de tela e desliga todas as telas além da do
# notebook (eDP-1): o LG, a portátil ou qualquer outra ligada na hora.
# Por quê, o protetor: parado 10 minutos, o Omarchy abre o protetor animado, e o wayvnc passa a
# mandar de 6,5 a 9,6 Mbps (pico de 27) pelo túnel da Cloudflare sem ninguém mexendo (medido em
# 04/11/2026). Usa o interruptor do próprio Omarchy (omarchy-toggle screensaver-off, o mesmo do
# menu): o omarchy-launch-screensaver não abre nada com ele ligado, e o bloqueio dos 30 minutos
# continua igual. Só desliga o interruptor no fim se foi este serviço que ligou; a marca fica em
# ~/.local/state/vnc-sessao/, para sobreviver a um reinício do serviço ou do notebook.
# Por quê, as telas: o wayvnc só captura o eDP-1 (--output no wayvnc.service). Com outra tela
# ligada, a área de trabalho que está nela some de quem está no VNC. Desligada, as janelas vêm para o
# notebook. Religa com "hyprctl reload", que relê o monitors.lua, como o selfdesk-tela-unica.
# Com sessão do SelfDesk aberta, quem religa é o selfdesk-tela-unica quando ela fecha. Se ela
# fechar com alguém no VNC, ele não religa e deixa a marca MARCA_RELIGAR, e este serviço religa
# quando o último cliente do VNC sair. O último acesso remoto a fechar religa as telas.
# Se uma tela for ligada à mão durante o VNC, fica ligada: o serviço só insiste nos primeiros
# CARENCIA_S, porque no começo de uma sessão remota o LG já religou sozinho (05/11/2026).
# Se nenhuma outra tela estava ligada quando o VNC conectou, o fim não religa nada.
# Eventos: wayvncctl --json event-receive (client-connected e client-disconnected trazem o
# connection_count; com --wait e --reconnect, wayvnc-startup e wayvnc-shutdown a cada reinício).
# Roda como serviço: ~/.config/systemd/user/vnc-sessao.service.
set -uo pipefail

# A tela que fica ligada. Com ela desligada (tampa fechada), o serviço não mexe nas telas.
readonly TELA_NOTEBOOK=eDP-1
# O [k] fica de fora da linha de comando do próprio pgrep: o --service do SelfDesk toma qualquer
# processo com "<caminho do SelfDesk> --cm" na linha de comando por uma sessão, e reinicia o
# --server quando ele some (veja CM_PGREP no selfdesk-tela-unica).
readonly CM_PGREP='/usr/share/SelfDesk/selfdes[k] --cm'
readonly TOGGLE='screensaver-off'
readonly MARCA_PROTETOR="$HOME/.local/state/vnc-sessao/protetor-desligado"
# Deixada pelo selfdesk-tela-unica quando não religou as telas por causa do VNC. Mesmo caminho lá.
readonly MARCA_RELIGAR="${XDG_RUNTIME_DIR:-/run/user/$UID}/telas-religar-depois-do-vnc"
readonly INTERVALO_S=2
# Até aqui, contado do desligar, uma tela ligada é o religar sozinho do começo da sessão.
readonly CARENCIA_S=20

ativo=false
desligou_em=''        # $SECONDS do desligar das telas nesta sessão do VNC
religar_no_fim=false  # foi este serviço que desligou as telas

avisar() {  # $1: título, $2: texto
  notify-send -a wayvnc -i preferences-desktop-remote-desktop "$1" "$2" 2>/dev/null || true
}

# Telas ligadas além do notebook, no formato do output do hl.monitor (mesma função no
# selfdesk-tela-unica, onde está o porquê). Vazio se o notebook não estiver ligado.
telas_extras() {
  hyprctl monitors -j | jq -r --arg n "$TELA_NOTEBOOK" '
    select(any(.[]; .name == $n)) | .[] | select(.name != $n)
    | if (.description // "") != "" and (.description | test("[\"\\\\]") | not)
      then "desc:" + .description else .name end'
}

extra_ligada() {
  [[ -n $(telas_extras) ]]
}

sessao_selfdesk() {
  pgrep -xf "$CM_PGREP" >/dev/null
}

clientes_vnc() {  # imprime quantos clientes o wayvnc tem agora (0 se ele não responder)
  local n
  n=$(timeout 5 wayvncctl -j client-list 2>/dev/null | jq 'length' 2>/dev/null)
  echo "${n:-0}"
}

desligar_extras() {  # $1: o que disparou
  local alvos alvo
  mapfile -t alvos < <(telas_extras)
  (( ${#alvos[@]} > 0 )) || return 1
  for alvo in "${alvos[@]}"; do
    hyprctl eval "hl.monitor({ output = \"$alvo\", disabled = true })" >/dev/null || return 1
  done
  echo "$1: desligadas ${alvos[*]#desc:}"
}

desligar_protetor() {
  if omarchy-toggle-enabled "$TOGGLE"; then return 0; fi  # já desligado por você: não é meu
  omarchy-toggle "$TOGGLE" on && mkdir -p "$(dirname "$MARCA_PROTETOR")" && touch "$MARCA_PROTETOR" &&
    echo "protetor de tela desligado"
}

devolver_protetor() {
  [[ -f $MARCA_PROTETOR ]] || return 0
  omarchy-toggle "$TOGGLE" off && rm -f "$MARCA_PROTETOR" && echo "protetor de tela religado"
}

ativar() {
  ativo=true
  desligar_protetor
  if desligar_extras "VNC conectado"; then
    desligou_em=$SECONDS
    religar_no_fim=true
    avisar "Telas extras desligadas: VNC conectado" \
      "O VNC só mostra o notebook. As outras telas voltam quando o VNC desconectar. Para usar agora, ligue pelo painel Display."
  fi
}

desativar() {  # $1: o que disparou
  ativo=false
  devolver_protetor
  if { $religar_no_fim || [[ -f $MARCA_RELIGAR ]]; } && ! sessao_selfdesk; then
    rm -f "$MARCA_RELIGAR"
    hyprctl reload >/dev/null && echo "$1: telas religadas (hyprctl reload)"
  fi
  desligou_em=''
  religar_no_fim=false
}

ajustar() {  # $1: clientes conectados agora, $2: o que disparou
  if (( $1 > 0 )) && ! $ativo; then
    ativar
  elif (( $1 == 0 )) && $ativo; then
    desativar "$2"
  fi
}

insistir() {
  $ativo && [[ -n $desligou_em ]] || return 0
  if (( SECONDS - desligou_em >= CARENCIA_S )); then
    desligou_em=''  # passou a carência: uma tela ligada agora foi à mão e fica
  elif extra_ligada; then
    desligar_extras "tela religou sozinha no começo do VNC"
  fi
}

tratar_evento() {  # $1: uma linha JSON do wayvncctl
  local metodo n
  metodo=$(jq -r '.method // empty' <<<"$1" 2>/dev/null)
  case $metodo in
    client-connected | client-disconnected)
      n=$(jq -r '.params.connection_count // 0' <<<"$1")
      ajustar "$n" "VNC desconectado"
      ;;
    wayvnc-startup) ajustar "$(clientes_vnc)" "wayvnc reiniciado sem clientes" ;;
    wayvnc-shutdown) ajustar 0 "wayvnc parado" ;;
  esac
}

encerrar() {
  if $ativo; then desativar "serviço parado"; fi
  exit 0
}
trap encerrar TERM INT

# Uma marca que sobrou (serviço morto, notebook desligado com o VNC aberto) e ninguém no VNC:
# devolve o protetor já no início, mesmo que o wayvnc demore a subir.
if (( $(clientes_vnc) == 0 )); then devolver_protetor; fi

exec {eventos}< <(wayvncctl -j -w -r event-receive 2>/dev/null)

while true; do
  if IFS= read -r -t "$INTERVALO_S" -u "$eventos" linha; then
    tratar_evento "$linha"
  elif (( $? <= 128 )); then
    echo "wayvncctl event-receive terminou" >&2
    if $ativo; then desativar "wayvncctl terminou"; fi
    exit 1
  fi
  insistir
done
