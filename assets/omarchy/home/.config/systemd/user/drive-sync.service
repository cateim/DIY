[Unit]
Description=rclone bisync de ~/Drive com o Google Drive

[Service]
Type=oneshot
# Rodada travada vira falha, e aviso, em vez de parada muda (uma rodada normal leva uns 8 min).
TimeoutStartSec=2h
ExecCondition=/usr/bin/sh -c "findmnt -no SOURCE /home | grep -q '^/dev/mapper/cateim'"
ExecStart=/usr/bin/rclone bisync gdrive: <<HOME>>/Drive --workdir <<HOME>>/.local/state/rclone/bisync --filters-file <<HOME>>/.config/rclone/gdrive-filtros.txt --drive-skip-gdocs --drive-skip-shortcuts --resilient --recover --max-lock 2m --max-delete 5 --conflict-resolve newer --log-file <<HOME>>/.local/state/drive-sync.log --log-level INFO
# Avisa na tela quando a rodada falha, e quando volta a funcionar (06/11).
ExecStopPost=-<<HOME>>/.local/bin/drive-sync-aviso
Nice=10
IOSchedulingClass=idle
