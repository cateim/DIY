{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 1800
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "cateim.keyboard-layout"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "cateim.window-switcher"
    }
  ]
}
